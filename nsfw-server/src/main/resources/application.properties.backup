server.port=8082
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=10MB

# 模型配置 (旧配置，向后兼容)
nsfw.model.path=classpath:models/falconsai.onnx
nsfw.model.input-width=224
nsfw.model.input-height=224
nsfw.model.threshold=0.5

# 扩展模型配置 (新配置)
# 模型类型选择: 5class (原五分类), 2class/falconsai (二分类), original (原模型，同5class)
nsfw.model.type=falconsai

# 标签文件路径 (可选，默认根据类型选择)
# nsfw.model.labels-path=classpath:models/labels_falconsai.txt

# 归一化配置 (可选，支持不同预处理方式)
# 归一化类型: vit (ViT标准归一化, mean=0.5, std=0.5), imagenet (ImageNet归一化), custom (自定义)
nsfw.model.normalization.type=custom
# 自定义归一化参数 (当normalization.type=custom时使用)
# FalconsAI 模型推荐使用 mean=0.0,0.0,0.0 和 std=1.0,1.0,1.0
nsfw.model.mean=0.0,0.0,0.0
nsfw.model.std=1.0,1.0,1.0

# FalconsAI 模型示例配置
# nsfw.model.type=falconsai
# nsfw.model.path=classpath:models/falconsai.onnx
# nsfw.model.labels-path=classpath:models/labels_falconsai.txt
# nsfw.model.normalization.type=custom
# nsfw.model.mean=0.0,0.0,0.0
# nsfw.model.std=1.0,1.0,1.0
# nsfw.model.threshold=0.5

# YOLOv8n配置
nsfw.model.yolo-enabled=true
nsfw.model.yolo-confidence-threshold=0.4
nsfw.model.yolo-model-path=classpath:models/yolov8s.onnx

# Logging configuration
logging.level.org.example.nsfwserver=DEBUG
logging.level.ai.djl=WARN
logging.file.name=nsfw-server.log