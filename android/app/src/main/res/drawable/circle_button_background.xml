<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">

    <!-- 完全透明背景 -->
    <solid android:color="#00FF0000" />

    <!-- 透明边框（完全看不见） -->
    <stroke
        android:width="2dp"
        android:color="#00FFFFFF" />

    <!-- 阴影 -->
    <padding
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="4dp" />

</shape>